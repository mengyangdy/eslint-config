{
  "name": "@dylanjs/eslint-config",
  "type": "module",
  "version": "0.2.11",
  "packageManager": "pnpm@10.6.2",
  "description": "eslint flat config presets with prettier.",
  "license": "MIT",
  "keywords": ["eslint", "eslint-config", "eslint-config-vue", "prettier"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "cleanup": "dy cleanup",
    "cm": "git add . && dy git-commit -l=zh-cn",
    "lint": "eslint . --fix",
    "ncu": "dy ncu",
    "publish-pkg": "pnpm run build && npm publish --access public",
    "release": "dy release",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "peerDependencies": {
    "@unocss/eslint-config": ">=0.58.0",
    "eslint": ">=8.40.0",
    "eslint-plugin-astro": ">=0.30.0",
    "eslint-plugin-react": ">=7.0.0",
    "eslint-plugin-react-hooks": ">=4.0.0",
    "eslint-plugin-react-native": ">=4.0.0",
    "eslint-plugin-react-refresh": ">=0.4.0",
    "eslint-plugin-solid": ">=0.10.0",
    "eslint-plugin-svelte": ">=2.0.0",
    "eslint-plugin-vue": ">=9.19.0",
    "prettier-plugin-astro": ">=0.12.0",
    "prettier-plugin-svelte": ">=3.0.0",
    "prettier-plugin-toml": ">=2.0.0",
    "typescript": ">=5.0.0",
    "vue-eslint-parser": ">=9.3.2"
  },
  "peerDependenciesMeta": {
    "@toml-tools/parser": {
      "optional": true
    },
    "@unocss/eslint-config": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-native": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-solid": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-svelte": {
      "optional": true
    },
    "prettier-plugin-toml": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-define-config": "1.23.0-2",
    "@antfu/install-pkg": "^1.0.0",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-parser-plain": "^0.1.1",
    "eslint-plugin-import-x": "^4.11.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "local-pkg": "^1.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-jsdoc": "1.3.2",
    "prettier-plugin-json-sort": "0.0.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@dylanjs/cli": "^1.0.4",
    "@toml-tools/parser": "^1.0.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^22.15.2",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier-plugin-toml": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.1.3"
  }
}
